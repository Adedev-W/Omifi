# Backend storage and network
CV_DATABASE_URL=sqlite:///./data/cv_editor.db
CV_ARTIFACT_DIR=./data/artifacts
CV_PUBLIC_BASE_URL=http://localhost:8080
CV_BACKEND_HOST=0.0.0.0
CV_BACKEND_PORT=8080
CV_WORKSPACE_ROOT=.

# Set strong random values for local or shared environments.
CV_INTERNAL_API_KEY=replace-with-a-long-random-backend-key
CV_LATEX_ENGINE=xelatex
CV_LATEX_TIMEOUT_SECONDS=30
CV_MAX_UPLOAD_BYTES=5242880
CV_MAX_SOURCE_BYTES=1048576
CV_MAX_LOG_BYTES=65536
CV_MAX_ARTIFACT_BYTES=10485760
CV_ARTIFACT_RETENTION_DAYS=30
CV_BUSY_TIMEOUT_SECONDS=5

# Langflow integration
CV_LANGFLOW_URL=http://localhost:7860
CV_LANGFLOW_API_KEY=replace-with-your-langflow-api-key
CV_LANGFLOW_FLOW_CV_EDIT=
CV_LANGFLOW_FLOW_CV_JUDGE=

# Used by Langflow components and the file gateway.
# Keep this equal to CV_INTERNAL_API_KEY when backend auth is enabled.
LATEX_BACKEND_URL=http://localhost:8080
LATEX_BACKEND_API_KEY=replace-with-the-same-backend-key
LANGFLOW_COMPONENTS_PATH=./langflow_components/cv_automation
LANGFLOW_URL=http://localhost:7860
TAVILY_API_KEY=
